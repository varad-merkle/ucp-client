# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# dentsu AI gateway - runs the shopping chat.

# ----------------------------------------------------
# Common Headers - Do not change unless informed by the Global IT team
MODEL_ENDPOINT = 'https://ai-api-dev.dentsu.com/'
api_version = '2024-10-21'
APIVERSION = 'V15'

# ----------------------------------------------------
# Enter your service line and Brand
SERVICE_LINE = 'cxm'                   # use as per your service line: creative, cxm, media or functions
BRAND = 'merkle'                       # use as per brand you are tagged to: carat, dentsu, dentsu creative, iprospect, merkle, tag

# ----------------------------------------------------
# The login for the demo. Created in the app_user table the first time the server
# starts, and each account gets its own buyer profile. The database is the source
# of truth from then on: changing these values does NOT change an account that
# already exists (delete its row to re-create it). When sign-up is added, employees
# make their own accounts and this is only the bootstrap.
DEMO_USER = 'demo'
DEMO_PASSWORD = 'change-me'

# ----------------------------------------------------
# PostgreSQL - buyer profile storage (profile_store.py)
# Point these at your own database. The buyer_profile table is created automatically on startup.
DB_HOST = 'localhost'                  # server host name or IP
DB_PORT = '5432'                       # optional, defaults to 5432
DB_NAME = 'ucp_client'                 # database name
DB_USER = 'your_db_user'               # database user
DB_PASSWORD = 'XXXXXX'                 # password for DB_USER

# ----------------------------------------------------
# Text/GPT Headers
CHAT_MODEL_NAME = 'gpt-4.1'
AZURE_OPENAI_API_KEY = 'XXXXXX'
PROJECT = 'XXXXX'                      # same as your Text Subscription name e.g., DGS_AIEngaged_DDMMM
DEPLOYMENT = 'gpt-4.1'
