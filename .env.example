# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# dentsu AI gateway - runs the shopping chat.

# ----------------------------------------------------
# Common Headers - Do not change unless informed by the Global IT team
MODEL_ENDPOINT = 'https://ai-api-dev.dentsu.com/'
api_version = '2024-10-21'
APIVERSION = 'V15'

# ----------------------------------------------------
# Enter your service line and Brand
SERVICE_LINE = 'cxm'                   # use as per your service line: creative, cxm, media or functions
BRAND = 'merkle'                       # use as per brand you are tagged to: carat, dentsu, dentsu creative, iprospect, merkle, tag

# ----------------------------------------------------
# The login for the demo. Created in the app_user table the first time the server
# starts, and each account gets its own buyer profile. The database is the source
# of truth from then on: changing these values does NOT change an account that
# already exists (delete its row to re-create it). When sign-up is added, employees
# make their own accounts and this is only the bootstrap.
DEMO_USER = 'demo'
DEMO_PASSWORD = 'change-me'

# ----------------------------------------------------
# PostgreSQL - buyer profile storage (profile_store.py)
# Point these at your own database. The buyer_profile table is created automatically on startup.
DB_HOST = 'localhost'                  # server host name or IP
DB_PORT = '5432'                       # optional, defaults to 5432
DB_NAME = 'ucp_client'                 # database name
DB_USER = 'your_db_user'               # database user
DB_PASSWORD = 'XXXXXX'                 # password for DB_USER

# ----------------------------------------------------
# Text/GPT Headers
CHAT_MODEL_NAME = 'gpt-4.1'
AZURE_OPENAI_API_KEY = 'XXXXXX'
PROJECT = 'XXXXX'                      # same as your Text Subscription name e.g., DGS_AIEngaged_DDMMM
DEPLOYMENT = 'gpt-4.1'

# ----------------------------------------------------
# Identity linking (identity.py) - shop as the user's own store account, not as a guest.
# Off until IDENTITY_TOKEN_KEY and store credentials are both set; guest shopping is unchanged either way.
#
# Key that encrypts the stored store tokens. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes existing links unreadable (users simply link again).
IDENTITY_TOKEN_KEY = ''

# Your Dev Dashboard agent client: https://dev.shopify.com/dashboard/ -> Catalogs -> Get an API key.
# Shopify recognises this one client at Shop accounts AND at every store, so one pair is enough.
# Register the redirect URI below on it. A per-store pair (store id in capitals) overrides it:
SHOPIFY_CLIENT_ID = ''
SHOPIFY_CLIENT_SECRET = ''
# SHOPIFY_CLIENT_ID_ALLBIRDS = ''
# SHOPIFY_CLIENT_SECRET_ALLBIRDS = ''

# Scopes. Defaults follow Shopify's buyer-linked token guide; change only if Shopify asks.
# SHOP_ACCOUNTS_SCOPES = 'openid email dev.ucp.shopping.checkout:manage'
# SHOPIFY_STORE_SCOPES = 'openid dev.ucp.shopping.checkout:manage'

# Only if Shop accounts gave you a separate client; otherwise the pair above is used.
# SHOP_ACCOUNTS_CLIENT_ID = ''
# SHOP_ACCOUNTS_CLIENT_SECRET = ''

# Token exchange audience: the store domain, as Shopify documents. Set to 'issuer' for the
# generic UCP wording (the store's authorization server issuer).
# IDENTITY_AUDIENCE = ''

# Where the authorization server sends the browser back. Defaults to <ngrok url>/api/identity/callback;
# it must match the redirect URI registered with Shopify exactly.
# IDENTITY_REDIRECT_URI = ''
# Where the browser lands after linking.
FRONTEND_URL = 'http://localhost:5173'
